# Required: where templates are stored. Production must use the same cluster and database
# as the data you expect to see. In MongoDB Atlas, Network Access must allow the host's outbound IPs.
MONGODB_CONNECTION_STRING=
# Optional: database name (default cala_contour).
MONGODB_DB=

# Required for Cala queries (falls back to ../cala-data/.env locally).
CALA_API_KEY=

# Optional: enables the in-app AI assistant and "Fill from a deck".
ANTHROPIC_API_KEY=

# Aiven Runtime supplies PORT; local server defaults to 5055.
PORT=5055
